<launch>
  <arg name="robot_ns" default="dracomancer_mkii"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="panel" default="true"/>
  <arg name="mount_height" default="1.0"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <group ns="$(arg robot_ns)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find dracomancer_mkii_ros)/urdf/mkii.urdf.xacro' robot_ns:=$(arg robot_ns) mount_height:=$(arg mount_height)"/>
    <rosparam command="load" file="$(find dracomancer_mkii_ros)/config/joints.yaml"/>
    <rosparam command="load" file="$(find dracomancer_mkii_ros)/config/controllers.yaml"/>
    <node pkg="gazebo_ros" type="spawn_model" name="spawn" args="-urdf -param robot_description -model $(arg robot_ns)" output="screen"/>
    <!-- control.py loads controllers and starts position controllers before accepting commands. -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
    <node pkg="dracomancer_mkii_ros" type="control.py" name="control" output="screen">
      <param name="backend" value="gazebo"/>
    </node>
    <node pkg="dracomancer_mkii_ros" type="panel.py" name="panel" if="$(arg panel)" output="screen">
      <remap from="joint_states" to="joint_cmd"/>
    </node>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find dracomancer_mkii_ros)/config/mkii.rviz" if="$(arg rviz)"/>
  </group>
</launch>
