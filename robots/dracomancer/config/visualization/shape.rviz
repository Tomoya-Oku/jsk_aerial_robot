Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 38; 38; 38
    Frame Rate: 15
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Cell Size: 0.25
      Offset: {X: 0.0, Y: 1.0, Z: 0.0}
    - Class: rviz/RobotModel
      Name: Dracomancer Mk-II
      Enabled: true
      Robot Description: /dracomancer/robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/RobotModel
      Name: DRAGON Gazebo feedback
      Enabled: true
      Robot Description: /dragon/robot_description
      TF Prefix: dragon_view
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/MarkerArray
      Name: Human cyan and DRAGON orange centerlines
      Enabled: true
      Marker Topic: /dracomancer/shape/markers
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4.8
      Focal Point: {X: 0.0, Y: 1.0, Z: 0.7}
      Pitch: 0.40
      Yaw: 3.60
Window Geometry:
  Width: 1300
  Height: 850
