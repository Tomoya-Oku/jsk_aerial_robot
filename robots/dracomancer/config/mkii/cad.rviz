Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 38; 38; 38
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 12
      Cell Size: 0.15
      Offset: {X: 0.0, Y: 0.0, Z: 0.08}
    - Class: rviz/RobotModel
      Name: Dracomancer Mk-II
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.65
      Focal Point: {X: 0.025, Y: 0.0, Z: 0.39}
      Pitch: 0.18
      Yaw: 3.45
Window Geometry:
  Width: 1100
  Height: 800
