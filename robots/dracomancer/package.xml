<?xml version="1.0"?>
<package format="2">
  <name>dracomancer</name>
  <version>0.1.0</version>
  <description>Dracomancer Mk-II CAD model, direct-UART control, and DRAGON shape teleoperation.</description>
  <maintainer email="oku@dragon.t.u-tokyo.ac.jp">Tomoya Oku</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/Tomoya-Oku/jsk_aerial_robot</url>
  <author email="oku@dragon.t.u-tokyo.ac.jp">Tomoya Oku</author>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>eigen</build_depend>
  <build_depend>gazebo_dev</build_depend>
  <build_depend>python3-dev</build_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_msgs</depend>
  <depend>dragon</depend>
  <depend>nlopt</depend>
  <depend>pluginlib</depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>spinal</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <export>
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
