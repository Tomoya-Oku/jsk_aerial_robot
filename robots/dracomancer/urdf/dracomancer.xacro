<?xml version="1.0"?>
<robot name="exoskeleton" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- パラメータ -->
  <xacro:property name="upper_arm_length" value="0.30"/>
  <xacro:property name="forearm_length" value="0.25"/>
  <xacro:property name="hand_length" value="0.12"/>

  <!-- 材質 -->
  <material name="gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.4 0.9 1.0"/>
  </material>

  <!-- base -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.08 0.08 0.08"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- shoulder yaw -->
  <link name="shoulder_yaw_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="shoulder_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_yaw_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="2.0"/>
  </joint>

  <!-- shoulder pitch -->
  <link name="shoulder_pitch_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_yaw_link"/>
    <child link="shoulder_pitch_link"/>
    <origin xyz="0 0 0.04" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
  </joint>

  <!-- upper arm -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 -${upper_arm_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${upper_arm_length}"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="shoulder_roll" type="revolute">
    <parent link="shoulder_pitch_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
  </joint>

  <!-- forearm -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 -${forearm_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="${forearm_length}"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 -${upper_arm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.6" effort="10" velocity="2.0"/>
  </joint>

  <!-- hand -->
  <link name="hand_link">
    <visual>
      <origin xyz="0 0 -${hand_length/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.03 ${hand_length}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm_link"/>
    <child link="hand_link"/>
    <origin xyz="0 0 -${forearm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="10" velocity="2.0"/>
  </joint>

</robot>