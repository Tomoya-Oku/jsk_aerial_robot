<?xml version="1.0"?>
<robot name="dracomancer">

  <!-- ===================== -->
  <!-- Materials            -->
  <!-- ===================== -->
  <material name="gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <!-- ===================== -->
  <!-- base -->
  <!-- ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/base.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/base.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ===================== -->
  <!-- shoulder -->
  <!-- ===================== -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/shoulder.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/shoulder.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <!-- 肩関節位置に合わせて調整 -->
    <origin xyz="0.00 0.15 0.20" rpy="0 0 0"/>
    <!-- 仮: 肩ピッチ -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="2.0"/>
  </joint>

  <!-- ===================== -->
  <!-- upper arm upper -->
  <!-- ===================== -->
  <link name="upper_arm_upper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/upper_arm_upper.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/upper_arm_upper.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="upper_arm_upper_joint" type="fixed">
    <parent link="shoulder_link"/>
    <child link="upper_arm_upper_link"/>
    <!-- まずは固定でつなぐ -->
    <origin xyz="0.03 0.00 0.00" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- upper arm lower -->
  <!-- ===================== -->
  <link name="upper_arm_lower_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/upper_arm_lower.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/upper_arm_lower.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="upper_arm_lower_joint" type="fixed">
    <parent link="upper_arm_upper_link"/>
    <child link="upper_arm_lower_link"/>
    <origin xyz="0.20 0.00 0.00" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- lower arm upper -->
  <!-- ===================== -->
  <link name="lower_arm_upper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/lower_arm_upper.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/lower_arm_upper.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_lower_link"/>
    <child link="lower_arm_upper_link"/>
    <!-- 肘関節位置に合わせて調整 -->
    <origin xyz="0.20 0.00 0.00" rpy="0 0 0"/>
    <!-- 仮: 肘屈曲 -->
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.4" effort="20" velocity="2.0"/>
  </joint>

  <!-- ===================== -->
  <!-- lower arm lower -->
  <!-- ===================== -->
  <link name="lower_arm_lower_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/lower_arm_lower.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/lower_arm_lower.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="lower_arm_lower_joint" type="fixed">
    <parent link="lower_arm_upper_link"/>
    <child link="lower_arm_lower_link"/>
    <origin xyz="0.18 0.00 0.00" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- wrist -->
  <!-- ===================== -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/wrist.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/wrist.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="lower_arm_lower_link"/>
    <child link="wrist_link"/>
    <!-- 手首関節位置に合わせて調整 -->
    <origin xyz="0.18 0.00 0.00" rpy="0 0 0"/>
    <!-- 仮: 手首ピッチ -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="10" velocity="2.0"/>
  </joint>

  <!-- ===================== -->
  <!-- hand -->
  <!-- ===================== -->
  <link name="hand_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/hand.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/hand.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="hand_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="hand_link"/>
    <origin xyz="0.08 0.00 0.00" rpy="0 0 0"/>
  </joint>

</robot>