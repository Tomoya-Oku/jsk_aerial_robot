    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dracomancer/urdf/mesh/shoulder.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.02060 0.00001 -0.03074" rpy="0 0 0"/>
      <mass value="0.09741"/>
      <inertia
        ixx="0.00013664905"
        ixy="0.00000420553"
        ixz="-0.00007588934"
        iyy="0.00025835443"
        iyz="-0.00000180233"
        izz="0.00013162476"/>
      </inertial>
  </link>

  <joint name="shoulder_flexion_extension_joint" type="revolute">
