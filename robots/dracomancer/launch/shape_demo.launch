<launch>
  <!-- Ground-only simulation: no takeoff or fictitious HOVER state. -->
  <arg name="gui" default="true"/>
  <arg name="motion" default="false"/>
  <arg name="motion_pattern" default="sine"/>
  <arg name="motion_seed" default="27"/>
  <arg name="panel" default="$(eval not arg('motion'))"/>
  <arg name="rviz" default="true"/>
  <arg name="stock_shape_config" value="$(find dracomancer)/config/control/shape.yaml"/>
  <arg name="shape_config" default="$(arg stock_shape_config)"/>
  <arg name="assembly" default="false"/>
  <arg name="geometry_only" default="false" doc="Preview geometric mapping in the ground simulator without flight feasibility gating."/>
  <arg name="assembly_defaults" value="$(eval arg('assembly') and arg('shape_config') == arg('stock_shape_config'))"/>
  <arg name="display_gap" default="2.0" doc="Distance between the two model origins in RViz, in metres."/>
  <arg name="display_height" value="$(eval 0.35 if arg('assembly') else 1.0)"/>
  <arg name="comparison_origin" value="$(eval [0.0, arg('display_gap') / 2.0, 1.55])"/>
  <arg name="mapping_mode" default="$(eval 'dual_shape' if arg('assembly') else 'shape')"/>
  <arg name="assembly_alignment" value="$(eval [0.0, 0.0, -pi / 2 if arg('mapping_mode') == 'dual_shape' else pi])"/>
  <arg name="force_dimensions" default="2"/>
  <arg name="torso_point" default="[0, 0, 0]"/>
  <!-- Approved simulation proxy only; safety thresholds remain unchanged. -->
  <include file="$(find dracomancer)/launch/view.launch">
    <arg name="rviz" value="false"/>
    <arg name="panel" value="$(arg panel)"/>
    <arg name="assembly" value="$(arg assembly)"/>
    <arg name="mount_height" value="$(arg display_height)"/>
  </include>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find aerial_robot_simulation)/gazebo_model/world/empty.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <include file="$(find dragon)/launch/bringup.launch">
    <arg name="real_machine" value="false"/>
    <arg name="simulation" value="true"/>
    <arg name="headless" value="true"/>
    <arg name="launch_gazebo" value="false"/>
    <arg name="spawn_y" value="1.2"/>
    <arg name="preflight_joint_control" value="true"/>
  </include>
  <!-- Reuse measured DRAGON joints with a fixed root for the comparison view. -->
  <group ns="dragon">
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="display_state">
      <param name="tf_prefix" value="dragon_view"/>
    </node>
    <node pkg="aerial_robot_model" type="rotor_tf_publisher" name="display_rotors">
      <param name="tf_prefix" value="dragon_view"/>
    </node>
    <node pkg="tf2_ros" type="static_transform_publisher" name="display_mount"
          args="0 $(arg display_gap) $(arg display_height) 0 0 0 world dragon_view/root"/>
  </group>
  <node pkg="rviz" type="rviz" name="shape_rviz" if="$(arg rviz)"
        args="-d $(find dracomancer)/config/control/shape.rviz"/>
  <include file="$(find dracomancer)/launch/teleoperation.launch">
    <arg name="device_ns" value="dracomancer"/>
    <arg name="mapping_mode" value="$(arg mapping_mode)"/>
    <arg name="force_dimensions" value="$(arg force_dimensions)"/>
    <arg name="shape_config" value="$(arg shape_config)"/>
    <arg name="teleop_mode" value="true"/>
    <arg name="publish_joints_only_when_hovering" value="false"/>
    <arg name="enable_feasibility_gate" value="$(eval not arg('geometry_only'))"/>
    <arg name="enable_volume_radius_monitor" value="$(eval not arg('geometry_only'))"/>
    <arg name="enable_fc_min_lowpass" value="$(eval not arg('geometry_only'))"/>
  </include>
  <!-- Match the hand points to this assembly's left and right parts. -->
  <rosparam command="load" ns="/dracomancer_control_joint_angle/shape"
            file="$(find dracomancer)/config/control/assembly.yaml" if="$(arg assembly_defaults)"/>
  <!-- Align the torso-to-shoulder (+X) or left-to-right (-Y) direction with DRAGON's -X. -->
  <rosparam param="/dracomancer_control_joint_angle/shape/human_alignment" subst_value="true"
            if="$(eval arg('assembly_defaults') and arg('mapping_mode') in ['shape', 'dual_shape'])">
    $(arg assembly_alignment)
  </rosparam>
  <!-- Loaded after teleoperation's private YAML so the demo value wins. -->
  <rosparam param="/dracomancer_control_joint_angle/shape/torso_point"
            subst_value="true">$(arg torso_point)</rosparam>
  <param name="/dracomancer_control_joint_angle/dragon_marker_frame" value="dragon_view/link4"/>
  <rosparam param="/dracomancer_control_joint_angle/shape_marker_origin"
            subst_value="true">$(arg comparison_origin)</rosparam>
  <node pkg="dracomancer" type="shape_input.py" name="shape_input" if="$(arg motion)">
    <param name="pattern" value="$(arg motion_pattern)"/>
    <param name="seed" type="int" value="$(arg motion_seed)"/>
  </node>
</launch>
