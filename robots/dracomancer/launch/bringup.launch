<launch>
  <arg name="backend" default="viewer" doc="viewer, gazebo, hardware, preview"/>
  <arg name="selected" value="$(eval {'viewer': 'viewer', 'gazebo': 'gazebo', 'hardware': 'hardware', 'preview': 'preview'}[arg('backend')])"/>
  <arg name="robot_ns" default="$(eval 'dracomancer_preview' if arg('selected') == 'preview' else 'dracomancer')"/>
  <arg name="rviz" default="true"/>
  <arg name="panel" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="mount_height" default="1.0"/>
  <arg name="config" default="$(find dracomancer)/config/device/hardware.yaml"/>
  <arg name="dual_spinal" default="true"/>
  <arg name="spinal_ns" default="$(eval '/' if arg('selected') == 'preview' and not arg('dual_spinal') else '/dracomancer')"/>
  <arg name="connect_fc" default="false"/>
  <arg name="fc_serial_port" default="/dev/ttyUSB0"/>
  <arg name="fc_serial_baud" default="921600"/>
  <arg name="teleop_mode" default="false"/>
  <arg name="shape_config" default="$(find dracomancer)/config/control/shape.yaml"/>
  <arg name="mapping_mode" default="shape"/>
  <arg name="force_dimensions" default="2"/>
  <arg name="enable_haptics" default="false"/>
  <arg name="enable_position_control" default="false"/>
  <arg name="anchor_mode" default="$(eval 'mid' if arg('mapping_mode').startswith('dual_') else 'none')"/>

  <arg name="assembly" default="false"/>
  <arg name="arm" default="right"/>
  <arg name="servo_ids" default="$(eval [11, 12, 13, 14, 15, 16, 17] if arg('arm') == 'left' else [1, 2, 3, 4, 5, 6, 7])"/>
  <arg name="assembly_view" value="$(eval arg('selected') == 'viewer' and arg('assembly'))"/>
  <arg name="rviz_config" value="$(eval 'observe.rviz' if arg('selected') == 'preview' else ('cad.rviz' if arg('assembly_view') else 'mkii.rviz'))"/>
  <arg name="target_ns" default="dragon"/>
  <arg name="start_control" default="$(eval arg('teleop_mode') or arg('enable_haptics') or arg('enable_position_control'))"
       doc="Start the controllers even when teleop_mode initially waits for a mode command."/>
  <arg name="js_raw_topic" default="$(eval (arg('spinal_ns').rstrip('/') if arg('selected') == 'hardware' else '/' + arg('robot_ns')) + '/right/joystick/raw')"/>
  <arg name="left_js_raw_topic" default="$(eval (arg('spinal_ns').rstrip('/') if arg('selected') == 'hardware' else '/' + arg('robot_ns')) + '/left/joystick/raw')"/>
  <arg name="imu_topic" default="$(eval (arg('spinal_ns').rstrip('/') if arg('selected') == 'hardware' else '/' + arg('robot_ns')) + '/imu')"/>
  <arg name="left_joystick_calibration" default="$(env HOME)/.ros/dracomancer-joystick-left.yaml"/>
  <arg name="device_joint_topic" default="/$(arg robot_ns)/measured_joint_states" />
  <arg name="enable_feasibility_gate" default="true" />
  <arg name="feasibility_gate_mode" default="hold" />
  <arg name="feasibility_service" default="/$(arg target_ns)/shape_feasibility/check_shape" />
  <arg name="robot_model_plugin_name" default="dragon/full_vectoring_robot_model" />
  <arg name="shape_feasibility_prediction_mode" default="allocation" />
  <arg name="use_contact_wrench" default="false" />
  <arg name="shape_feasibility_gimbal_feedback_topic" default="gimbals_ctrl" />
  <arg name="shape_feasibility_baselink_rpy_topic" default="final_target_baselink_rpy" />
  <arg name="shape_feasibility_baselink_odom_topic" default="uav/baselink/odom" />
  <arg name="shape_feasibility_use_gimbal_feedback" default="true" />
  <arg name="shape_feasibility_use_baselink_rpy_feedback" default="true" />
  <arg name="shape_feasibility_use_baselink_odom_feedback" default="true" />
  <arg name="shape_feasibility_feedback_timeout" default="0.25" />
  <arg name="shape_feasibility_allocation_refine_max_iteration" default="5" />
  <arg name="shape_feasibility_allocation_refine_threshold" default="0.0001" />
  <arg name="feasibility_rate" default="10.0" />
  <arg name="force_radius_threshold" default="0.108990" />
  <arg name="torque_radius_threshold" default="0.015400" />
  <arg name="force_radius_recover_threshold" default="0.249220" />
  <arg name="torque_radius_recover_threshold" default="0.278159" />
  <arg name="enable_volume_radius_monitor" default="true" />
  <arg name="enable_shape_safety" default="true" />
  <arg name="missing_inradius_scale" default="1.0" />
  <arg name="min_safety_scale" default="0.0" />
  <arg name="force_inradius_min" default="0.249220" />
  <arg name="torque_inradius_min" default="0.278159" />
  <arg name="force_inradius_hard_min" default="0.108990" />
  <arg name="torque_inradius_hard_min" default="0.015400" />
  <arg name="inradius_timeout" default="0.5" />
  <arg name="safety_log_period" default="1.0" />
  <arg name="enable_fc_min_lowpass" default="true" />
  <arg name="fc_min_lowpass_cutoff_hz" default="2.0" />
  <arg name="monitor_force_inradius_topic" default="$(eval '/' + arg('target_ns') + '/debug/fc_f_min' + ('_filtered' if arg('enable_fc_min_lowpass') else ''))" />
  <arg name="monitor_torque_inradius_topic" default="$(eval '/' + arg('target_ns') + '/debug/fc_t_min' + ('_filtered' if arg('enable_fc_min_lowpass') else ''))" />
  <arg name="max_step" default="0.015" />
  <arg name="max_joint_velocity" default="0.1" />
  <arg name="human_description" default="/$(arg robot_ns)/robot_description" />
  <arg name="position_velocity_only" default="true" />
  <arg name="joy_timeout" default="0.1" />
  <arg name="enable_joint_angle_control" default="$(arg start_control)"
       doc="Enable the shape controller, including when start_control is false."/>
  <arg name="publish_joints_only_when_hovering" default="true" />

  <include file="$(find dracomancer)/launch/bridge.launch"
           if="$(eval arg('selected') in ['hardware', 'preview'] and arg('connect_fc'))">
    <arg name="spinal_ns" value="$(arg spinal_ns)"/>
    <arg name="serial_port" value="$(arg fc_serial_port)"/>
    <arg name="serial_baud" value="$(arg fc_serial_baud)"/>
  </include>
  <include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(eval arg('selected') == 'gazebo')">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <group ns="$(arg robot_ns)">
    <param unless="$(arg assembly_view)" name="robot_description" command="$(find xacro)/xacro '$(find dracomancer)/urdf/dracomancer.urdf.xacro' robot_ns:=$(arg robot_ns) mount_height:=$(arg mount_height)"/>
    <param if="$(arg assembly_view)" name="robot_description" textfile="$(find dracomancer)/urdf/dracomancer.urdf"/>
    <!-- Map the assembly's shoulder direction (+X) to the viewer's up direction (+Z). -->
    <node if="$(arg assembly_view)" pkg="tf2_ros" type="static_transform_publisher" name="upright"
          args="0 0 $(arg mount_height) 0 -1.570796326794897 0 world base_link"/>
    <rosparam command="load" file="$(find dracomancer)/config/model/joints.yaml"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
    <group if="$(eval arg('selected') == 'gazebo')">
      <rosparam command="load" file="$(find dracomancer)/config/simulation/controllers.yaml"/>
      <node pkg="gazebo_ros" type="spawn_model" name="spawn" args="-urdf -param robot_description -model $(arg robot_ns)" output="screen"/>
    </group>
    <node if="$(eval arg('selected') in ['viewer', 'gazebo'])" pkg="dracomancer" type="backend.py" name="control" output="screen">
      <param name="backend" value="$(arg selected)"/>
    </node>
    <node if="$(eval arg('selected') == 'hardware')" pkg="dracomancer" type="direct.py" name="spinal_control" output="screen" required="true">
      <rosparam command="load" file="$(arg config)"/>
      <param name="dual_spinal" value="$(arg dual_spinal)"/>
      <param name="spinal_ns" value="$(arg spinal_ns)"/>
      <param unless="$(arg dual_spinal)" name="mode_service" value="$(eval arg('spinal_ns').rstrip('/')+'/direct_servo_mode')"/>
      <param unless="$(arg dual_spinal)" name="state_topic" value="$(eval arg('spinal_ns').rstrip('/')+'/servo/states')"/>
      <param unless="$(arg dual_spinal)" name="current_topic" value="$(eval arg('spinal_ns').rstrip('/')+'/servo/direct_current')"/>
      <param name="haptic_feedback" value="$(arg enable_haptics)"/>
    </node>
    <node if="$(eval arg('selected') == 'preview')" pkg="dracomancer" type="observe.py" name="observe" required="true" output="screen">
      <param name="spinal_ns" value="$(arg spinal_ns)"/>
      <param name="dual_spinal" value="$(arg dual_spinal)"/>
      <param name="arm" value="$(arg arm)"/>
      <rosparam param="servo_ids" subst_value="true">$(arg servo_ids)</rosparam>
    </node>
    <node if="$(eval arg('panel') and arg('selected') != 'preview')" pkg="dracomancer" type="panel.py" name="panel" output="screen">
      <remap unless="$(eval arg('selected') == 'hardware')" from="joint_states" to="joint_cmd"/>
      <param name="haptic_feedback" value="$(eval arg('selected') == 'hardware' and arg('enable_haptics'))"/>
    </node>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find dracomancer)/config/visualization/$(arg rviz_config)" if="$(arg rviz)"/>
  </group>

  <include file="$(find dracomancer)/launch/shape.launch" pass_all_args="true"
           if="$(eval (arg('start_control') or arg('enable_joint_angle_control')) and arg('selected') != 'preview')">
    <arg name="publish_joints_only_when_hovering"
         value="$(eval arg('selected') == 'hardware' or arg('publish_joints_only_when_hovering'))"/>
  </include>

  <group if="$(eval arg('start_control') and arg('selected') != 'preview')">
    <include file="$(find dracomancer)/launch/include/feedback.launch" if="$(arg enable_haptics)">
      <arg name="robot_ns" value="$(arg robot_ns)"/>
      <arg name="target_ns" value="$(arg target_ns)"/>
      <arg name="mapping_mode" value="$(arg mapping_mode)"/>
      <arg name="anchor_mode" value="$(arg anchor_mode)"/>
      <arg name="shape_config" value="$(arg shape_config)"/>
      <arg name="hardware" value="$(eval arg('selected') == 'hardware')"/>
    </include>

    <include file="$(find dracomancer)/launch/pose.launch">
      <arg name="device_ns" value="$(arg robot_ns)"/>
      <arg name="js_raw_topic" value="$(arg js_raw_topic)"/>
      <arg name="left_js_raw_topic" value="$(arg left_js_raw_topic)"/>
      <arg name="imu_topic" value="$(arg imu_topic)"/>
      <arg name="left_joystick_calibration" value="$(arg left_joystick_calibration)"/>
      <arg name="robot_ns" value="$(arg target_ns)"/>
      <arg name="mapping_mode" value="$(arg mapping_mode)"/>
      <arg name="anchor_mode" value="$(arg anchor_mode)"/>
      <arg name="shape_config" value="$(arg shape_config)"/>
      <arg name="teleop_mode" value="$(arg teleop_mode)"/>
      <arg name="enable_position_control" value="$(arg enable_position_control)"/>
      <arg name="position_velocity_only" value="$(arg position_velocity_only)"/>
      <arg name="joy_timeout" value="$(arg joy_timeout)"/>
    </include>
  </group>
</launch>
