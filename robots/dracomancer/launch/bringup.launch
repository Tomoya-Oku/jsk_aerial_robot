<?xml version="1.0"?>
<launch>
  ##############  launch config  ###########
  <arg name="rm" default="True" />
  <arg name="sim" default="False" />
  <arg name="real_machine" default="$(eval arg('rm') and not arg('sim'))" />
  <arg name="simulation" default="$(arg sim)" />

  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world" />
  <arg name="launch_gazebo" default="True" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="0.0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="mujoco" default="False" />
  <arg name="robot_ns" value="dracomancer" />
  <arg name="headless" default="True" />
  <arg name="launch_rviz" default="False" />
  <arg name="connect_fc" default="$(arg real_machine)" />
  <arg name="fc_serial_port" default="/dev/flight_controller" />
  <arg name="fc_serial_baud" default="921600" />
  <arg name="run_servo_rough_calib" default="False" />

  <arg name="gui" default="False" />
  <arg name="joint_gui" default="$(arg gui)" />
  <arg name="model_headless" value="$(eval arg('headless') or not arg('launch_rviz'))" />

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(arg simulation)" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg model_headless)" />
    <arg name="robot_model" value="$(find dracomancer)/urdf/dracomancer.urdf" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(find dracomancer)/config/rviz_config" />
    <arg name="rviz_init_pose" value="$(find dracomancer)/config/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include >

  ###########  Sensors  ###########
  <include file="$(find dracomancer)/launch/include/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="connect_fc" value="$(arg connect_fc)" />
    <arg name="fc_serial_port" value="$(arg fc_serial_port)" />
    <arg name="fc_serial_baud" value="$(arg fc_serial_baud)" />
    <arg name="run_servo_rough_calib" value="$(arg run_servo_rough_calib)" />
  </include >

  ###########  Servo Bridge  ###########
  <node unless="$(arg joint_gui)" pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge"  output="screen" ns="$(arg robot_ns)">
    <param name="simulation_mode" value="$(eval arg('simulation') and not arg('real_machine'))" />
    <param name="use_mujoco" value="true" if="$(arg mujoco)"/>
  </node>

  ###########  Joint State Publisher  ###########
  <node if="$(arg joint_gui)"
      pkg="joint_state_publisher_gui"
      type="joint_state_publisher_gui"
      name="joint_state_publisher_gui"
      ns="$(arg robot_ns)">
  </node>

</launch>
