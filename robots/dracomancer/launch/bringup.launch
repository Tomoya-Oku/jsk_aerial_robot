<?xml version="1.0"?>
<launch>
  <!-- ◎ 実機 + mocap の最小 -->
  <arg name="real_machine" default="True"/>
  <arg name="simulation"  default="False"/>
  <arg name="estimate_mode" default="1"/>  <!-- mocap不安定対策モード推奨 -->
  <arg name="headless" default="True"/>
  <arg name="use_mocap" default="True"/>
  <arg name="robot_ns" value="dracomancer"/>
  <arg name="config_dir" default="$(find dracomancer)/config"/>

  <group ns="$(arg robot_ns)">
    <param name="estimation/mode" value="$(arg estimate_mode)"/>
    <param name="uav_model" value="0"/>
    <rosparam file="$(arg config_dir)/model/DracomancerModel.yaml" command="load"/>
    <rosparam file="$(arg config_dir)/MotorInfo.yaml" command="load"/>
    <rosparam file="$(arg config_dir)/control/DracomancerControl.yaml" command="load"/>
    <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load"/>
    <!-- NavigationConfig.yaml は使わないなら削除 -->
  </group>

  <node pkg="aerial_robot_base" type="aerial_robot_base_node"
        name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen">
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="40"/>
  </node>

  <!-- URDF 読み込みのみ（シミ不要） -->
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch">
    <arg name="headless" value="$(arg headless)"/>
    <arg name="robot_model" value="$(find dracomancer)/urdf/device.urdf.xacro"/>
    <arg name="robot_ns" value="$(arg robot_ns)"/>
    <arg name="need_joint_state" value="false"/>
  </include>

  <!-- mocap だけ起動（sensors.launch.xml 側で mocap 以外は無効化） -->
  <include file="$(find dracomancer)/launch/include/sensors.launch.xml">
    <arg name="real_machine" value="$(arg real_machine)"/>
    <arg name="simulation" value="$(arg simulation)"/>
    <arg name="robot_ns" value="$(arg robot_ns)"/>
    <arg name="use_mocap" value="$(arg use_mocap)"/>
  </include>
</launch>