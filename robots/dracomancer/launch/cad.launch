<launch>
  <group ns="dracomancer_cad">
    <!-- Keep the CAD pose's frames scoped to this viewer. -->
    <remap from="/tf" to="tf"/>
    <remap from="/tf_static" to="tf_static"/>
    <param name="robot_description" textfile="$(find dracomancer)/urdf/assembly.urdf"/>
    <!-- Map the CAD model's shoulder direction (+X) to the viewer's up direction (+Z). -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="upright"
          args="0 0 0 0 -1.570796326794897 0 cad_view base_link"/>
    <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find dracomancer)/config/mkii/cad.rviz" output="screen"/>
  </group>
</launch>
