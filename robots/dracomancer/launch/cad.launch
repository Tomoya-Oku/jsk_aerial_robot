<launch>
  <arg name="panel" default="true"/>
  <group>
    <!-- Keep the CAD pose's frames scoped to this viewer. -->
    <remap from="/tf" to="/dracomancer_cad/tf"/>
    <remap from="/tf_static" to="/dracomancer_cad/tf_static"/>
    <include file="$(find dracomancer)/launch/view.launch">
      <arg name="robot_ns" value="dracomancer_cad"/>
      <arg name="assembly" value="true"/>
      <arg name="mount_height" value="0.0"/>
      <arg name="panel" value="$(arg panel)"/>
    </include>
  </group>
</launch>
