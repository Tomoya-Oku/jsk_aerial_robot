<launch>
  <!-- Mk-II viewer: joint_cmd to joint_states with the CAD angle/torque panel. -->
  <arg name="robot_ns" default="dracomancer"/>
  <arg name="rviz" default="true"/>
  <arg name="panel" default="true"/>
  <arg name="mount_height" default="1.0"/>
  <arg name="assembly" default="false"/>
  <arg name="rviz_config" value="$(eval 'cad.rviz' if arg('assembly') else 'mkii.rviz')"/>
  <group ns="$(arg robot_ns)">
    <param unless="$(arg assembly)" name="robot_description" command="$(find xacro)/xacro --inorder '$(find dracomancer)/urdf/mkii.urdf.xacro' robot_ns:=$(arg robot_ns) mount_height:=$(arg mount_height)"/>
    <param if="$(arg assembly)" name="robot_description" textfile="$(find dracomancer)/urdf/assembly.urdf"/>
    <!-- Map the assembly's shoulder direction (+X) to the viewer's up direction (+Z). -->
    <node if="$(arg assembly)" pkg="tf2_ros" type="static_transform_publisher" name="upright"
          args="0 0 $(arg mount_height) 0 -1.570796326794897 0 world base_link"/>
    <rosparam command="load" file="$(find dracomancer)/config/mkii/joints.yaml"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
    <node pkg="dracomancer" type="control.py" name="control" output="screen">
      <param name="backend" value="viewer"/>
    </node>
    <node pkg="dracomancer" type="panel.py" name="panel" if="$(arg panel)" output="screen">
      <remap from="joint_states" to="joint_cmd"/>
    </node>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find dracomancer)/config/mkii/$(arg rviz_config)" if="$(arg rviz)"/>
  </group>
</launch>
