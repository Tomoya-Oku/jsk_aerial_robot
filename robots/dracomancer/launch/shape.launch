<launch>
  <!-- Use the calibrated device measurements and the running DRAGON model. -->
  <arg name="robot_ns" default="dracomancer" doc="Dracomancer device namespace"/>
  <arg name="target_ns" default="dragon" doc="DRAGON namespace"/>
  <arg name="shape_config" default="$(find dracomancer)/config/control/shape.yaml"/>
  <arg name="mapping_mode" default="shape"/>
  <arg name="enabled" default="false" doc="Enable joint commands at startup when controller conditions are met."/>
  <arg name="enable_joint_angle_control" default="true" />
  <arg name="force_dimensions" default="2"/>
  <arg name="device_joint_topic" default="/$(arg robot_ns)/measured_joint_states" />
  <arg name="enable_feasibility_gate" default="true" />
  <arg name="feasibility_gate_mode" default="hold" />
  <arg name="feasibility_service" default="/$(arg target_ns)/shape_feasibility/check_shape" />
  <arg name="robot_model_plugin_name" default="dragon/full_vectoring_robot_model" />
  <arg name="shape_feasibility_prediction_mode" default="allocation" />
  <arg name="use_contact_wrench" default="false" />
  <arg name="shape_feasibility_gimbal_feedback_topic" default="gimbals_ctrl" />
  <arg name="shape_feasibility_baselink_rpy_topic" default="final_target_baselink_rpy" />
  <arg name="shape_feasibility_baselink_odom_topic" default="uav/baselink/odom" />
  <arg name="shape_feasibility_use_gimbal_feedback" default="true" />
  <arg name="shape_feasibility_use_baselink_rpy_feedback" default="true" />
  <arg name="shape_feasibility_use_baselink_odom_feedback" default="true" />
  <arg name="shape_feasibility_feedback_timeout" default="0.25" />
  <arg name="shape_feasibility_allocation_refine_max_iteration" default="5" />
  <arg name="shape_feasibility_allocation_refine_threshold" default="0.0001" />
  <arg name="feasibility_rate" default="10.0" />
  <arg name="force_radius_threshold" default="0.108990" />
  <arg name="torque_radius_threshold" default="0.015400" />
  <arg name="force_radius_recover_threshold" default="0.249220" />
  <arg name="torque_radius_recover_threshold" default="0.278159" />
  <arg name="enable_volume_radius_monitor" default="true" />
  <arg name="enable_shape_safety" default="true" />
  <arg name="missing_inradius_scale" default="1.0" />
  <arg name="min_safety_scale" default="0.0" />
  <arg name="force_inradius_min" default="0.249220" />
  <arg name="torque_inradius_min" default="0.278159" />
  <arg name="force_inradius_hard_min" default="0.108990" />
  <arg name="torque_inradius_hard_min" default="0.015400" />
  <arg name="inradius_timeout" default="0.5" />
  <arg name="safety_log_period" default="1.0" />
  <arg name="enable_fc_min_lowpass" default="true" />
  <arg name="fc_min_lowpass_cutoff_hz" default="2.0" />
  <arg name="monitor_force_inradius_topic" default="$(eval '/' + arg('target_ns') + '/debug/fc_f_min' + ('_filtered' if arg('enable_fc_min_lowpass') else ''))" />
  <arg name="monitor_torque_inradius_topic" default="$(eval '/' + arg('target_ns') + '/debug/fc_t_min' + ('_filtered' if arg('enable_fc_min_lowpass') else ''))" />
  <arg name="max_step" default="0.015" />
  <arg name="max_joint_velocity" default="0.1" />
  <arg name="human_description" default="/$(arg robot_ns)/robot_description" />
  <arg name="publish_joints_only_when_hovering" default="true" />

  <node pkg="dracomancer" type="volume_radius_monitor.py" name="$(arg robot_ns)_volume_radius_monitor" output="screen" if="$(arg enable_volume_radius_monitor)">
    <param name="robot_name" value="$(arg target_ns)" />
    <param name="device_ns" value="/$(arg robot_ns)" />
    <param name="rate" value="40.0" />
    <param name="force_inradius_topic" value="$(arg monitor_force_inradius_topic)" />
    <param name="torque_inradius_topic" value="$(arg monitor_torque_inradius_topic)" />
    <param name="force_inradius_min" value="$(arg force_inradius_min)" />
    <param name="torque_inradius_min" value="$(arg torque_inradius_min)" />
    <param name="force_inradius_hard_min" value="$(arg force_inradius_hard_min)" />
    <param name="torque_inradius_hard_min" value="$(arg torque_inradius_hard_min)" />
    <param name="inradius_timeout" value="$(arg inradius_timeout)" />
    <param name="enable_shape_safety" value="$(arg enable_shape_safety)" />
    <param name="missing_inradius_scale" value="$(arg missing_inradius_scale)" />
    <param name="min_safety_scale" value="$(arg min_safety_scale)" />
    <param name="safety_log_period" value="$(arg safety_log_period)" />
  </node>

  <node pkg="dracomancer" type="volume_radius_monitor.py" args="--filter" name="teleop_fc_min_lowpass" ns="$(arg target_ns)" output="screen" if="$(arg enable_fc_min_lowpass)">
    <param name="robot_name" value="$(arg target_ns)" />
    <param name="cutoff_hz" value="$(arg fc_min_lowpass_cutoff_hz)" />
  </node>

  <node pkg="dracomancer" type="shape_feasibility_node" name="shape_feasibility" ns="$(arg target_ns)" output="screen" if="$(arg enable_feasibility_gate)">
    <param name="robot_model_plugin_name" value="$(arg robot_model_plugin_name)" />
    <param name="prediction_mode" value="$(arg shape_feasibility_prediction_mode)" />
    <param name="force_dimensions" value="$(arg force_dimensions)" />
    <param name="gimbal_feedback_topic" value="$(arg shape_feasibility_gimbal_feedback_topic)" />
    <param name="baselink_rpy_topic" value="$(arg shape_feasibility_baselink_rpy_topic)" />
    <param name="baselink_odom_topic" value="$(arg shape_feasibility_baselink_odom_topic)" />
    <param name="use_gimbal_feedback" value="$(arg shape_feasibility_use_gimbal_feedback)" />
    <param name="use_baselink_rpy_feedback" value="$(arg shape_feasibility_use_baselink_rpy_feedback)" />
    <param name="use_baselink_odom_feedback" value="$(arg shape_feasibility_use_baselink_odom_feedback)" />
    <param name="feedback_timeout" value="$(arg shape_feasibility_feedback_timeout)" />
    <param name="allocation_refine_max_iteration" value="$(arg shape_feasibility_allocation_refine_max_iteration)" />
    <param name="allocation_refine_threshold" value="$(arg shape_feasibility_allocation_refine_threshold)" />
  </node>

  <node pkg="dracomancer" type="control_shape.py" name="$(arg robot_ns)_control_joint_angle" output="screen" if="$(arg enable_joint_angle_control)">
    <param name="device_ns" value="/$(arg robot_ns)" />
    <param name="robot_name" value="$(arg target_ns)" />
    <param name="mapping_mode" value="$(arg mapping_mode)" />
    <param name="device_joint_topic" value="$(arg device_joint_topic)" />
    <param name="human_description" value="$(arg human_description)" />
    <param name="enabled" type="bool" value="$(arg enabled)" />
    <param name="publish_only_when_hovering" value="$(arg publish_joints_only_when_hovering)" />
    <param name="enable_feasibility_gate" value="$(arg enable_feasibility_gate)" />
    <param name="feasibility_gate_mode" value="$(arg feasibility_gate_mode)" />
    <param name="feasibility_service" value="$(arg feasibility_service)" />
    <param name="use_contact_wrench" value="$(arg use_contact_wrench)" />
    <param name="feasibility_rate" value="$(arg feasibility_rate)" />
    <param name="force_radius_threshold" value="$(arg force_radius_threshold)" />
    <param name="torque_radius_threshold" value="$(arg torque_radius_threshold)" />
    <param name="force_radius_recover_threshold" value="$(arg force_radius_recover_threshold)" />
    <param name="torque_radius_recover_threshold" value="$(arg torque_radius_recover_threshold)" />
    <param name="max_step" value="$(arg max_step)" />
    <param name="max_joint_velocity" value="$(arg max_joint_velocity)" />
    <rosparam command="load" file="$(arg shape_config)" />
    <env name="OPENBLAS_NUM_THREADS" value="1" />
  </node>
</launch>
