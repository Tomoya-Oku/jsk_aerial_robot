<launch>
  <arg name="device_ns" default="dracomancer" />
  <arg name="js_raw_topic" default="/$(arg device_ns)/right/joystick/raw"/>
  <arg name="left_js_raw_topic" default="/$(arg device_ns)/left/joystick/raw"/>
  <arg name="left_joystick_calibration" default="$(env HOME)/.ros/dracomancer-joystick-left.yaml"/>
  <arg name="robot_ns" default="dragon" />
  <arg name="mapping_mode" default="shape" />
  <arg name="anchor_mode" default="none" />
  <arg name="imu_topic" default="/$(arg device_ns)/imu"/>
  <arg name="shape_config" default="$(find dracomancer)/config/control/shape.yaml" />
  <arg name="teleop_mode" default="false" />
  <arg name="enable_position_control" default="true" />
  <arg name="position_velocity_only" default="true" />
  <arg name="joy_timeout" default="0.1" />

  <node pkg="dracomancer" type="calibrate_joystick.py" name="$(arg device_ns)_calibrate_joystick" output="screen">
    <rosparam param="axis_indices">[0, 1]</rosparam>
    <rosparam param="invert_axes">[]</rosparam>
    <param name="rate" value="40" />
    <param name="js_raw_topic" value="$(arg js_raw_topic)" />
    <param name="js_calibrated_topic" value="/$(arg device_ns)/right/joystick/calibrated" />
    <param name="raw_timeout" value="$(arg joy_timeout)" />
    <param name="center_duration" value="2.0" />
    <param name="range_duration" value="5.0" />
    <param name="deadzone" value="0.05" />
    <param name="save_yaml" value="true" />
    <param name="use_saved_calibration" value="true" />
    <param name="yaml_path" value="$(find dracomancer)/config/device/joystick_calibration.yaml" />
  </node>

  <node pkg="dracomancer" type="calibrate_joystick.py" name="$(arg device_ns)_left_joystick"
        output="screen" if="$(eval arg('enable_position_control') and arg('mapping_mode').startswith('dual_'))">
    <param name="js_raw_topic" value="$(arg left_js_raw_topic)"/>
    <param name="js_calibrated_topic" value="/$(arg device_ns)/left/joystick/calibrated"/>
    <param name="raw_timeout" value="$(arg joy_timeout)"/>
    <param name="yaml_path" value="$(arg left_joystick_calibration)"/>
  </node>

  <node pkg="dracomancer" type="control_position.py" name="$(arg device_ns)_control_position" output="screen" if="$(eval arg('enable_position_control') or arg('anchor_mode') != 'none')">
    <param name="velocity_only" value="$(arg position_velocity_only)" />
    <param name="joy_timeout" value="$(arg joy_timeout)" />
    <param name="device_ns" value="/$(arg device_ns)" />
    <param name="imu_topic" value="$(arg imu_topic)"/>
    <param name="anchor_mode" value="$(arg anchor_mode)" />
    <param name="allow_joystick" value="$(arg enable_position_control)" />
    <param name="mapping_mode" value="$(arg mapping_mode)" />
    <rosparam command="load" file="$(arg shape_config)" />
    <param name="robot_name" value="$(arg robot_ns)" />
    <param name="teleop_mode" value="$(arg teleop_mode)" />
    <param name="rate" value="40.0" />
    <param name="joy_topic" value="/$(arg device_ns)/right/joystick/calibrated" />
    <param name="direction_mode" value="none" />
    <param name="scale_x" value="1.0" />
    <param name="scale_y" value="1.0" />
    <param name="scale_z" value="1.0" />
    <param name="deadzone" value="0.05" />
  </node>
</launch>
