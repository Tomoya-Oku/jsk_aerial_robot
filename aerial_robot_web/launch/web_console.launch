<?xml version="1.0"?>
<launch>
  <arg name="robot_ns" default="" />
  <arg name="robot_type" default="generic" />
  <arg name="pose_topic" default="" />
  <arg name="web_port" default="8080" />
  <arg name="rosbridge_port" default="9090" />
  <arg name="launch_rosbridge" default="true" />
  <arg name="rosbridge_output" default="log" />
  <arg name="auto_install_qr_dependency" default="true" />
  <arg name="banner_delay" default="8.0" />
  <arg name="rosbag_dir" default="$(optenv HOME /tmp)/rosbags" />
  <arg name="log_dir" default="$(optenv HOME /tmp)/.aerial_robot_web/logs" />
  <arg name="log_max_upload_gb" default="5.0" />
  <arg name="log_max_samples_per_topic" default="2000" />
  <arg name="log_keep_bag" default="false" />

  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch" if="$(arg launch_rosbridge)">
    <arg name="port" value="$(arg rosbridge_port)" />
    <arg name="output" value="$(arg rosbridge_output)" />
  </include>

  <node pkg="aerial_robot_web"
        type="aerial_robot_web_server.py"
        name="aerial_robot_web_server"
        output="screen">
    <param name="port" value="$(arg web_port)" />
    <param name="rosbridge_port" value="$(arg rosbridge_port)" />
    <param name="auto_install_qr_dependency" value="$(arg auto_install_qr_dependency)" />
    <param name="banner_delay" value="$(arg banner_delay)" />
    <param name="rosbag_dir" value="$(arg rosbag_dir)" />
    <param name="log_dir" value="$(arg log_dir)" />
    <param name="log_max_upload_gb" value="$(arg log_max_upload_gb)" />
    <param name="log_max_samples_per_topic" value="$(arg log_max_samples_per_topic)" />
    <param name="log_keep_bag" value="$(arg log_keep_bag)" />
    <param name="robot_ns" value="$(arg robot_ns)" />
    <param name="robot_type" value="$(arg robot_type)" />
    <param name="pose_topic" value="$(arg pose_topic)" />
  </node>
</launch>
